PLAVOR_DOMAIN=kdobi-gram.ddns.net

POSTGRES_DB=plavor
POSTGRES_USER=plavor
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Keep the backend reachable only from the server itself.
BACKEND_PORT=127.0.0.1:8080

JWT_SECRET=change-this-to-a-long-random-jwt-secret

KAKAO_REST_API_KEY=change-this-to-your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=change-this-to-your-kakao-client-secret
KAKAO_REDIRECT_URI=https://kdobi-gram.ddns.net/auth/kakao/callback
